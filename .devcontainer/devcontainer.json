{
  "name": "RenewaBlox sites",
  // Python builds both static sites (standard library only); Node runs the Atlas's gate tests.
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  // The Atlas served as plain files: the sign-in and the portal's key are Netlify edge functions, which a plain
  // server doesn't run, so every page opens without them here (see "Run locally" in the README).
  "postAttachCommand": {
    "atlas": "python3 atlas/build.py && python3 -m http.server 8901 -d atlas/site"
  },
  "portsAttributes": {
    "8901": {
      "label": "Atlas",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8901
  ]
}
