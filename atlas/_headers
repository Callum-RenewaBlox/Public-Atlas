# Header rules for the client pages on atlas.renewablox.com. `python atlas/build.py` adds them to the
# site's _headers, after the Atlas site's own (root/_headers), between marker lines; they cover /bln/ and
# nothing else.
# The pages load their own files and, for the map, the satellite imagery; the 3D viewer fetches its
# models from the same folder (and compiles its mesh decoder, so WebAssembly is allowed, not eval).
# nosniff, the referrer policy and the permissions policy come from the Atlas site's own /* rule:
# Netlify applies every rule that matches, so they are not repeated here.
/bln/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://server.arcgisonline.com; font-src 'self'; connect-src 'self' blob: data:; media-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'
  X-Robots-Tag: noindex, nofollow
